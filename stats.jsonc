{
  // Never change or reuse an id once released: BGA keys stat history by id. Ids are grouped by tens, add new ones in the gaps.
  // game_* stats auto-initialise to 0 (see Game::getDefaultStatValue).
  // game_monsters_killed exists in both sections: the player inc also bumps the table total.
  "table": {
    "game_heroes_won": {
      "id": 10,
      "name": "Heroes won",
      "type": "bool"
    },
    "game_rune_stone_position": {
      "id": 11,
      "name": "Rune Stone position",
      "type": "int"
    },
    "game_houses_remaining": {
      "id": 12,
      "name": "Town pieces left standing",
      "type": "int"
    },
    "game_monsters_reached_grimheim": {
